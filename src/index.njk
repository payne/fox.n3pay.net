<h1>N3PAY</h1>

<p>N3PAY has a <a href="https://store.ai6ym.radio/pages/picofox">PicoFOX</a>.</p>

<div id="status" class="status">
  <strong>Current Status:</strong> <span id="status-text">Loading...</span>
</div>

<div class="contact">
  <h2>Contact</h2>
  <p>
    Email: <a href="mailto:Matt.N3PAY@gmail.com">Matt.N3PAY@gmail.com</a><br>
    Cell: <a href="tel:402-208-8787">402-208-8787</a>
  </p>
</div>

<script>
  async function loadFoxLocation() {
    const statusEl = document.getElementById('status');
    const statusTextEl = document.getElementById('status-text');

    try {
      const response = await fetch('https://raw.githubusercontent.com/payne/fox1-location/refs/heads/main/fox1-location.json');
      const data = await response.json();

      if (data.storage) {
        statusEl.className = 'status storage';
        statusTextEl.textContent = 'Storage drawer';
      } else {
        const deployedDate = new Date(data.timeLocationUpdated);
        const formattedDate = deployedDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit',
          timeZoneName: 'short'
        });

        const mapsUrl = `https://www.google.com/maps?q=${data.latitude},${data.longitude}`;

        statusEl.className = 'status deployed';
        statusTextEl.innerHTML = `Deployed on ${formattedDate}<br>
          <a href="${mapsUrl}" target="_blank" rel="noopener noreferrer">View on Google Maps</a>`;
      }
    } catch (error) {
      statusTextEl.textContent = 'Unable to load status';
      console.error('Error loading fox location:', error);
    }
  }

  loadFoxLocation();
</script>
